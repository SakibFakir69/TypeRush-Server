// use prisma-8
enum UserRole {
  ADMIN
  USER
  ORG
}

model User {
  id            String               @id @default(uuid())
  name          String
  fullName      String
  age           Int?
  email         String               @unique
  password      String?
  country       String?
  googleId      String?              @unique
  authProvider  String               @default("local")
  emailVerified Boolean              @default(false)
  avatarUrl     String?
  bio           String?
  role          UserRole             @default(USER)
  isDelete      Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     temporal.updatedAt()
  results       Result[]
  contest       Contest[]
  participation ContestParticipant[]
}

model Result {
  id          String    @id @default(uuid())
  paragraphId String
  paragraph   Paragraph @relation(fields:[paragraphId], references:[id])

  userId      String?
  user        User?     @relation(fields:[userId], references:[id])

  wpm         Float
  accuracy    Float
  errors      Int
  timeTaken   Int
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([paragraphId])
}

model Paragraph {
  id         String   @id @default(uuid())
  content    String
  category   String?
  difficulty String?
  wordCount  Int
  createdAt  DateTime @default(now())
  results    Result[]
}

// CONTEST
model Contest {
  id           String               @id @default(uuid())
  name         String
  content      String
  time         Float
  createdAt    DateTime             @default(now())
  updatedAt    temporal.updatedAt()

  userId       String?
  user         User?                @relation(fields:[userId], references:[id])

  participants ContestParticipant[]
}

model ContestParticipant {
  userId    String
  contestId String
  joinedAt  DateTime @default(now())

  user      User     @relation(fields:[userId], references:[id])
  contest   Contest  @relation(fields:[contestId], references:[id])

  @@id([userId, contestId])
  @@index([userId, contestId])
}
