generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
  ORG
}

enum ConditionContest {
  RUNNING
  FINISHED
  UPCOMING
}

enum MatchStatus {
  WAITING
  ACTIVE
  COMPLETED
  ABANDONED
}

enum MatchResult {
  WIN
  LOSS
  DRAW
  ABANDONED
}
enum InviteStatus {
  PENDING
  MATCHED
  DECLINED
  CANCELLED
  EXPIRED
}

model User {
  id                 String               @id @default(uuid())
  name               String
  fullName           String
  age                Int?
  email              String               @unique
  password           String?
  country            String?
  googleId           String?              @unique
  authProvider       String               @default("local")
  emailVerified      Boolean              @default(false)
  avatarUrl          String?
  bio                String?
  xp                 Int                  @default(0)
  rating             Int                  @default(100)
  role               UserRole             @default(USER)
  isDelete           Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  results            Result[]
  contest            Contest[]
  participation      ContestParticipant[]
  announcement       Announcement[]
  matchesWon         Match[]              @relation("MatchWinner")
  matchParticipation MatchParticipant[]   @relation("MatchParticipant")
    invitesSent     PrivateInvite[] @relation("InviteInviter")
  invitesReceived PrivateInvite[] @relation("InviteInvitee")
}

model Result {
  id          String     @id @default(uuid())
  paragraphId String?
  paragraph   Paragraph? @relation(fields: [paragraphId], references: [id])
  userId      String?
  user        User?      @relation(fields: [userId], references: [id])
  contestId   String?
  contest     Contest?   @relation(fields: [contestId], references: [id])
  wpm         Float
  accuracy    Float
  errors      Int
  timeTaken   Int
  duration    Int?
  createdAt   DateTime   @default(now())

  @@index([userId])
  @@index([paragraphId])
  @@index([contestId])
  @@index([duration])
}

model Paragraph {
  id         String   @id @default(uuid())
  content    String
  language   String?  @default("en")
  category   String?
  difficulty String?
  wordCount  Int
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  matches    Match[]
    invites    PrivateInvite[]

  results Result[]
}

// CONTEST
model Contest {
  id           String               @id @default(uuid())
  name         String
  content      String
  time         Float
  contestDate  DateTime             @default(now())
  condition    ConditionContest     @default(UPCOMING)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  userId       String?
  user         User?                @relation(fields: [userId], references: [id])
  participants ContestParticipant[]
  results      Result[]
}

// after contest time over no one can particapant
model ContestParticipant {
  userId    String
  contestId String
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  contest Contest @relation(fields: [contestId], references: [id])

  @@id([userId, contestId])
  @@index([userId, contestId])
}

model Announcement {
  id        String   @id @default(uuid())
  message   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Match {
  id           String             @id @default(uuid())
  paragraphId  String
  paragraph    Paragraph          @relation(fields: [paragraphId], references: [id])
  status       MatchStatus        @default(WAITING)
   duration Int @default(30)
  createdAt    DateTime           @default(now())
  startedAt    DateTime?
  endedAt      DateTime?
  winnerId     String?
  winner       User?              @relation("MatchWinner", fields: [winnerId], references: [id])
  participants MatchParticipant[]
   invite       PrivateInvite?

  @@index([status])
}

model MatchParticipant {
  matchId      String
  match        Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation("MatchParticipant", fields: [userId], references: [id])
  ratingBefore Int          @default(1200)
  ratingAfter  Int?
  wpm          Float?
  accuracy     Float?
  errors       Int?
  result       MatchResult?
  joinedAt     DateTime     @default(now())

  @@id([matchId, userId])
  @@index([userId])
}


model PrivateInvite {
  id          String       @id @default(uuid())
  code        String       @unique
  inviterId   String
  inviter     User         @relation("InviteInviter", fields: [inviterId], references: [id])
  inviteeId   String?
  invitee     User?        @relation("InviteInvitee", fields: [inviteeId], references: [id])
  paragraphId String
  paragraph   Paragraph    @relation(fields: [paragraphId], references: [id])
  duration    Int
  status      InviteStatus @default(PENDING)
  matchId     String?      @unique
  match       Match?       @relation(fields: [matchId], references: [id])
  createdAt   DateTime     @default(now())
  respondedAt DateTime?
  expiresAt   DateTime

  @@index([inviterId])
  @@index([status])
}