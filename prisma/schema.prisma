generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
 
}

enum UserRole {
  ADMIN
  USER
  ORG
}

enum ConditionContest {
  RUNNING
  FINISHED
  UPCOMING
}

model User {
  id            String               @id @default(uuid())
  name          String
  fullName      String
  age           Int?
  email         String               @unique
  password      String?
  country       String?
  googleId      String?              @unique
  authProvider  String               @default("local")
  emailVerified Boolean              @default(false)
  avatarUrl     String?
  bio           String?
  xp            Int                @default(0)
  role          UserRole             @default(USER)
  isDelete      Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  results       Result[]
  contest       Contest[]
  participation ContestParticipant[]
  announcement  Announcement[]
}

model Result {
  id          String    @id @default(uuid())
  paragraphId String?
  paragraph   Paragraph? @relation(fields: [paragraphId], references: [id])

  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
    contestId   String?                                             
  contest     Contest?  @relation(fields: [contestId], references: [id])  

  wpm         Float
  accuracy    Float
  errors      Int
  timeTaken   Int
  /** Chosen run length in seconds (15 / 30 / 60 …) — leaderboard category. */
  duration    Int?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([paragraphId])
  @@index([contestId])
  @@index([duration])
}

model Paragraph {
  id         String   @id @default(uuid())
  content    String
  language   String?  @default("en")
  category   String?
  difficulty String?
  wordCount  Int
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())

  results    Result[]
}

// CONTEST
model Contest {
  id           String               @id @default(uuid())
  name         String
  content      String
  time         Float
  contestDate  DateTime             @default(now())
  condition    ConditionContest     @default(UPCOMING)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  userId       String?
  user         User?                @relation(fields: [userId], references: [id])
  participants ContestParticipant[]
  results Result[]
}

// after contest time over no one can particapant
model ContestParticipant {
  userId    String
  contestId String
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  contest   Contest  @relation(fields: [contestId], references: [id])

  @@id([userId, contestId])
  @@index([userId, contestId])
}

model Announcement {
  id        String   @id @default(uuid())
  message   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}